# Myangustis Parser (new tree) - socket-activated service.
#
# Started ONLY by myangustis-new.socket when a connection arrives;
# systemd hands this process the already-listening socket on fd 3
# (see service.js). The service exits itself after PARSER_IDLE_MS
# (default 5 minutes) with no requests.
#
# Do NOT enable this service: an enabled service runs all day.
# Enable only the socket:
#   systemctl enable --now myangustis-new.socket

[Unit]
Description=Myangustis Parser (new) service (woken by myangustis-new.socket)
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/user/Myangustis/B.Parser
ExecStart=/usr/local/bin/node /home/user/Myangustis/B.Parser/core/new/service.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
KillSignal=SIGINT
TimeoutStopSec=10
Environment=PARSER_IDLE_MS=300000
