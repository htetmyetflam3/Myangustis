# Key-only inventory for this checkout, with a separate main-JavaScript section.
# Copy to .env, then uncomment ONLY the keys you need and provide their values.
# Leaving the entries commented avoids overriding defaults with invalid blanks.
# .env is git-ignored; never commit credentials. Some programs read .env;
# others require variables in the process environment or an explicit env file.
# CAUTION: tools-box/bash/bootstrap.sh can regenerate and overwrite root .env.

# A.Engine — master encryption and tree overrides
#MASTER_JSON_KEY=
#MYANGUSTIS_MASTER_ENC=
#MYANGUSTIS_MASTER_KEY_FILE=
#MYANGUSTIS_TREE_DIR=

# B.Parser — API, paths and parser behaviour
#PRASER_KEY=
#PRASER_FONT_DIR=
#PRASER_OUTPUT_FONT_DIR=
#PRASER_UPLOAD_DIR=
#PRASER_OUTPUT_DIR=
#PRASER_MAP_DIR=
#PRASER_DOCX_LAYOUT=
#PRASER_ZAWCODE_DRAFT=
#PRASER_MAX_STREAM_MB=
#PRASER_MAX_DOCX_ENTRIES=
#PRASER_MAX_MEMBER_MB=
#PRASER_MAX_DOCX_TOTAL_MB=
#LOCAL_MAX_OCR_PIXELS=

# B.Parser — OCR
#PRASER_OCR=
#PRASER_OCR_LANG=
#PRASER_OCR_LANG_PATH=
#PRASER_TESSDATA_DIR=
#PRASER_TESSERACT_BIN=
#PRASER_OCR_BIN=
#PRASER_PDFTOPPM_BIN=
#PRASER_OCR_PSM=
#PRASER_OCR_DPI=
#PRASER_OCR_TIMEOUT_SECONDS=

# C.Proofreading — RapidAPI and translation (some tools use process env only)
#RAPIDAPI_KEY=
#RAPIDAPI_BASE_URL=
#RAPIDAPI_HOST=
#RAPIDAPI_CACHE=
#RAPIDAPI_ENV_FILE=
#AZURE_TRANSLATOR_KEY=
#AZURE_TRANSLATOR_REGION=
#AZURE_TRANSLATOR_ENDPOINT=
#MT_ENGINE_COMMAND=
#XDG_DATA_HOME=

# D.Scraper — search, site login and Hostinger email
#SERPAPI=
# Hostinger SMTP/IMAP password. Mail servers, sender and recipient are
# currently configured in D.Scraper/run/support/mailer.py, not via .env.
#MAIL_PASSWORD=
#LOGIN_EMAIL=
#LOGIN_USERNAME=
#LOGIN_PASSWORD=
#LOGIN_URL=
#LOGIN_USER_FIELD=
#LOGIN_PASS_FIELD=
# For host-specific LOGIN_<HOST>_* keys, replace <HOST> with the normalized
# host token (see D.Scraper/architecture/guard/helper/site_login.py).
#LOGIN_<HOST>_EMAIL=
#LOGIN_<HOST>_USERNAME=
#LOGIN_<HOST>_PASSWORD=
#LOGIN_<HOST>_URL=
#LOGIN_<HOST>_USER_FIELD=
#LOGIN_<HOST>_PASS_FIELD=
#PHATMAL_EMAIL=
#PHATMAL_PASSWORD=
#PHATMAL_API_KEY=
#PHATMAL_TOKEN=
#PHATMAL_UA=
#PHATMAL_COOKIE=

# D.Scraper — Scribd download tuning
#SCRIBD_CDP_TIMEOUT=
#SCRIBD_RENDER_SETTLE_TIMEOUT=
#SCRIBD_SCROLL_DELAY=
#SCRIBD_PAGE_LOAD_CONCURRENCY=
#SCRIBD_PAGE_LOAD_TIMEOUT=
#SCRIBD_EXPORT_BATCH_SIZE=
#SCRIBD_PDF_STREAM_CHUNK_SIZE=
#SCRIBD_HEADLESS=

# Remote file transfer — SSH_KEY is a private-key FILE PATH, not key contents
#SSH_HOST=
#SSH_USER=
#SSH_PORT=
#SSH_KEY=
#SSH_DIR=
# Continuous parse queue: one direct child of SSH_DIR (default: convertable).
# /old/ is treated as the relative child old, not an absolute path.
#REMOTE_PRASER_DIR=

# Model/tool access and optional tests
#HG_TOKEN=
#MYANGUSTIS_JS_REFERENCE_ROOT=
#MYANGUSTIS_REAL_OCR_TEST_PDF=

# Shell/deployment helpers in this checkout (not all are used by Python apps)
