# Copy to .env and uncomment only the settings you use. No values are included.
# .env is git-ignored. Some tools read it; others need process environment
# variables or an explicitly supplied env file. See each tool's documentation.
# Back up your .env: tools-box/bash/bootstrap.sh can overwrite the root file.

# Remote SSH: these names select the target used by the script you run.
# Use separate .env files on your local machine and VPS if they target different
# hosts. SSH_KEY is the path to a private key on the machine running the script.
#SSH_HOST=
#SSH_USER=
#SSH_PORT=
#SSH_KEY=
#SSH_DIR=
# Continuous parser queue: direct child of SSH_DIR (default: convertable).
# /old/ is treated as the relative child old, not a server-absolute path.
#REMOTE_PRASER_DIR=

# Optional parser lane decision file: on/true/1 enables it (default: off).
# Console/journal messages remain on either way. See B.Parser/README.md.
#PARSER_LOG_ENABLED=
# Optional file path; default: B.Parser/logs/lane-decisions.log.
#PARSER_LOG_FILE=

# Hostinger email notifications: the mailbox password only. The SMTP/IMAP
# servers, sender and recipient are in D.Scraper/run/support/mailer.py.
#MAIL_PASSWORD=

# Scraper search and optional website logins.
#SERPAPI=
#LOGIN_EMAIL=
#LOGIN_USERNAME=
#LOGIN_PASSWORD=
#LOGIN_URL=
#LOGIN_USER_FIELD=
#LOGIN_PASS_FIELD=
# Host-specific variants use LOGIN_<NORMALIZED_HOST>_<FIELD>; see site_login.py.

# Phatmal API, only if using that source: API key plus either a token or
# email/password. UA and cookie are optional.
#PHATMAL_API_KEY=
#PHATMAL_TOKEN=
#PHATMAL_EMAIL=
#PHATMAL_PASSWORD=
#PHATMAL_UA=
#PHATMAL_COOKIE=

# Hugging Face upload, when using tools-box/python/hfinit.py.
#HG_TOKEN=

# Optional translation providers. Azure tools read the process environment.
#RAPIDAPI_KEY=
#AZURE_TRANSLATOR_KEY=
#AZURE_TRANSLATOR_REGION=
#AZURE_TRANSLATOR_ENDPOINT=
#MT_ENGINE_COMMAND=

# Optional parser API key for non-loopback access (not needed for local calls).
#PRASER_KEY=

# Engine master key only when replacing the bundled public test key/master.
#MASTER_JSON_KEY=
#MYANGUSTIS_MASTER_KEY_FILE=

# Site/engine services on main: keys read by their actual runtime code, not
# required by the Python parser or scraper. COOKIE_SECRET and SESSION_SECRET
# must be different; engine-to-site and site-to-engine use separate keys.
#COOKIE_SECRET=
#SESSION_SECRET=
#SITE_TO_ENGINE_KEY=
#ENGINE_TO_SITE_KEY=
# Optional SQLite file path; otherwise the site uses its own default.
#DB_FILE=
