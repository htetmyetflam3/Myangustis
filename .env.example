# MYANGUSTIS CONFIGURATION
# Copy this file to .env, then uncomment and fill in only the settings you use.
# All fields below are blank; no passwords or keys are included.
# .env is git-ignored. Back it up: tools-box/bash/bootstrap.sh can overwrite it.
# Some tools require process environment variables or a specific env file;
# check their documentation if a setting is not picked up.

# ============================================================================
# 1. PARSER LOGGING
# ============================================================================
# Set PARSER_LOG_ENABLED to on to write lane decisions to a file. Leave blank
# or set it to off to disable the file. Console/journal logging stays on.
# Default file: B.Parser/logs/lane-decisions.log
# PARSER_LOG_FILE is optional; use it only to choose a different file.
# Restart the parser or combined service after changing these settings on the VPS.
#PARSER_LOG_ENABLED=
#PARSER_LOG_FILE=
# Per-page parsing diagnostics (off by default); see B.Parser/README.md.
#PARSER_DIAGNOSTICS=
# Sensitive text samples, only with diagnostics enabled (off by default).
#PARSER_DIAGNOSTIC_SAMPLES=

# ============================================================================
# 2. PARSER / OCR INPUTS
# ============================================================================
# Optional default input file or folder for local parse or OCR commands.
#PARSER_INPUT_DIR=
#PARSER_OCR_INPUT_DIR=

# ============================================================================
# 3. CONTINUOUS PARSER — SHARED-HOST SSH AND QUEUE
# ============================================================================
# SSH_KEY is the path to a private key on the machine running the script.
# Use separate .env files on your local machine and VPS if they target
# different hosts. SSH_DIR is the parent directory on the shared host.
#SSH_HOST=
#SSH_USER=
#SSH_PORT=
#SSH_KEY=
#SSH_DIR=

# Direct child of SSH_DIR; defaults to convertable. /old/ means the child
# named old inside SSH_DIR, not an absolute /old/ directory on the host.
#REMOTE_PRASER_DIR=
# Separate OCR queue inside SSH_DIR (default: scanned).
#REMOTE_OCR_DIR=

# ============================================================================
# 4. SCRAPER — EMAIL, SEARCH AND OPTIONAL WEBSITE LOGIN
# ============================================================================
# Hostinger mailbox password. SMTP/IMAP servers and addresses are configured
# in D.Scraper/run/support/mailer.py.
#MAIL_PASSWORD=

#SERPAPI=
#LOGIN_EMAIL=
#LOGIN_USERNAME=
#LOGIN_PASSWORD=
#LOGIN_URL=
#LOGIN_USER_FIELD=
#LOGIN_PASS_FIELD=
# Host-specific variants use LOGIN_<NORMALIZED_HOST>_<FIELD>; see site_login.py.

# ============================================================================
# 5. PHATMAL — ONLY IF USING THIS SOURCE
# ============================================================================
# API key plus either a token or email/password. UA and cookie are optional.
#PHATMAL_API_KEY=
#PHATMAL_TOKEN=
#PHATMAL_EMAIL=
#PHATMAL_PASSWORD=
#PHATMAL_UA=
#PHATMAL_COOKIE=

# ============================================================================
# 6. OPTIONAL UPLOAD AND TRANSLATION TOOLS
# ============================================================================
# Hugging Face upload (tools-box/python/hfinit.py).
#HG_TOKEN=

# Translation providers. Azure tools read the process environment.
#RAPIDAPI_KEY=
#AZURE_TRANSLATOR_KEY=
#AZURE_TRANSLATOR_REGION=
#AZURE_TRANSLATOR_ENDPOINT=
#MT_ENGINE_COMMAND=

# ============================================================================
# 7. PARSER API AND ENGINE KEYS
# ============================================================================
# Parser API key for non-loopback access; not needed for local calls.
#PRASER_KEY=

# Engine master key only when replacing the bundled public test key/master.
#MASTER_JSON_KEY=
#MYANGUSTIS_MASTER_KEY_FILE=

# ============================================================================
# 8. SITE / ENGINE SERVICES ON MAIN
# ============================================================================
# Not required by the Python parser or scraper. COOKIE_SECRET and
# SESSION_SECRET must differ; the two service-to-service keys are separate.
# SQLite uses its default location unless DB_FILE is set.
#COOKIE_SECRET=
#SESSION_SECRET=
#SITE_TO_ENGINE_KEY=
#ENGINE_TO_SITE_KEY=
#DB_FILE=
