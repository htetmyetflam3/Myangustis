{
  "name": "myangustis",
  "version": "2.0.1",
  "description": "Myangustis — Burmese text engine that is not an NLP research project.",
  "author": "KaungMyatThu",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "eslint.config.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --config F.Site/Frontend/frontend-bootstrap/vite.config.js",
    "build:react": "vite build --config F.Site/Frontend/frontend-react/vite.config.js",
    "build:wasm": "sh E.Scraper/main/deploy/continuous-ocr/rebuild-box.sh",
    "rebuild": "node E.Scraper/main/scripts/check-node.mjs && node Architecture/Engine/MonoSyllabism/mapbuilder/restore-master.js && node Architecture/Engine/MonoSyllabism/mapbuilder/obfuscator.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "dev": "nodemon --config F.Site/nodemon.json F.Site/index.js",
    "dev:engine": "nodemon --config Architecture/Engine/nodemon.json Architecture/Engine/index.js",
    "api": "node tools-box/js/api-server.js",
    "start": "node F.Site/index.js",
    "start:host": "node Architecture/host/index.js",
    "gh": "gh",
    "test": "node --test test/node/**/*.test.js",
    "test:site": "node --test test/node/site-test/*.test.js",
    "test:parser": "node --test test/node/parser-test/*.test.js",
    "test:engine": "node --test test/node/engine-test/*.test.js",
    "fix-imports": "node tools-box/js/fix-import.js ./"
  },
  "keywords": [
    "burmese",
    "myanmar",
    "myanmar-text",
    "zawgyi",
    "unicode",
    "pdf-parser",
    "docx-parser",
    "syllable-segmentation",
    "font-detection",
    "encoding-detection",
    "myanmar-ocr",
    "proofreading"
  ],
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "animejs": "^4.2.2",
    "axios": "^1.13.2",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bytenode": "^1.7.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.23.1",
    "fs-extra": "^11.3.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.0.2",
    "mysql2": "^3.16.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "^0.20.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-levenshtein": "^3.0.0",
    "harfbuzzjs": "1.6.3",
    "javascript-obfuscator": "^5.6.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.5",
    "randexp": "^0.5.3",
    "regexgen": "^1.3.0",
    "regexp-tree": "^0.1.27",
    "regexpp": "^3.2.0",
    "ret": "^0.5.0",
    "rimraf": "^6.1.2",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "4.1.17",
    "tapable": "^2.3.3",
    "tesseract.js": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "xregexp": "^5.1.2"
  }
}
